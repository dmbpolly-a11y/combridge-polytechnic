# ─────────────────────────────────────────────────────────────────────────────
# Combridge Polytechnic – Vite Environment Variables
#
# Copy this file to .env.local and fill in your real Supabase credentials.
# VITE_ prefix is required for variables to be accessible in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project URL  (Settings > API > Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon/Public Key  (Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# App Name (optional, displayed in UI)
VITE_APP_NAME="Combridge Polytechnic"
